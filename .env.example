# Local Postgres from docker-compose.dev.yml.
DATABASE_URL=postgres://fileee:fileee@localhost:5432/fileee

# Public URL of the app: used for origin checks, secure cookies and CORS rules.
APP_URL=http://localhost:3000
# openssl rand -base64 32
ENCRYPTION_KEY=
# Local MinIO (docker-compose.dev.yml) needs this. Keep it off in production unless you run your own storage.
ALLOW_PRIVATE_ENDPOINTS=true
# TRUST_PROXY=true  # only behind a reverse proxy that sets X-Forwarded-For
# SETUP_TOKEN=      # openssl rand -hex 16; asked for on the first-run setup page. Production won't start without it until setup is done.
